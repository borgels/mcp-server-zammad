# Your Zammad instance, e.g. https://yourcompany.zammad.com
ZAMMAD_BASE_URL=
# Personal access token. For per-user impersonation the token user needs
# admin.user (the From header is used to act as the requesting user).
ZAMMAD_API_TOKEN=
# Tool profile: "user" (self-service: tickets + knowledge base) or
# "technician" (adds search/triage, internal notes, users, orgs, tags).
ZAMMAD_PROFILE=user
# Honor the gateway-forwarded X-MCP-User header as the acting identity.
# Only enable behind a gateway that strips/sets this header itself.
ZAMMAD_TRUST_FORWARDED_USER=false
# Default group for new tickets.
ZAMMAD_DEFAULT_GROUP=Users
ZAMMAD_TIMEOUT_MS=30000
ZAMMAD_AUDIT_LOG=
