# Zammad base URL (the instance root; the server appends /api/v1).
ZAMMAD_URL=https://helpdesk.example.com
# Alias also accepted:
# ZAMMAD_BASE_URL=https://helpdesk.example.com

# HTTP access token from Zammad profile > Token Access.
ZAMMAD_TOKEN=

# Alternatively, an OAuth bearer token managed by another process:
# ZAMMAD_BEARER_TOKEN=

ZAMMAD_TIMEOUT_MS=30000

# Optional: enable the gated write tools (add_internal_note, add_article,
# set_state, add_tag, remove_tag, create_ticket, update_ticket).
# ZAMMAD_ENABLE_WRITES=false

# Optional Streamable HTTP hardening:
MCP_HTTP_HOST=127.0.0.1
PORT=3000
MCP_MAX_BODY_BYTES=10485760
# MCP_ALLOWED_ORIGINS=https://your-local-client.example
# MCP_ALLOW_ANY_ORIGIN=false
# MCP_HTTP_TOKEN=
