# Your Zammad instance, e.g. https://yourcompany.zammad.com
ZAMMAD_BASE_URL=
# Personal access token. For per-user impersonation the token user needs
# admin.user (the From header is used to act as the requesting user).
ZAMMAD_API_TOKEN=
# Tool profile: "user" (self-service: tickets + knowledge base) or
# "technician" (adds search/triage, internal notes, users, orgs, tags).
ZAMMAD_PROFILE=user
# Honor the gateway-forwarded X-MCP-User header as the acting identity.
# Only enable behind a gateway that strips/sets this header itself.
# When true, MCP_HTTP_TOKEN is required (the HTTP server refuses to start
# otherwise) and requests without X-MCP-User are rejected with 401.
ZAMMAD_TRUST_FORWARDED_USER=false
# HTTP only: run every request as the API token user when no trusted
# forwarded identity is configured. Off by default — without it (and without
# ZAMMAD_TRUST_FORWARDED_USER=true) the HTTP transport rejects all requests.
# stdio always runs as the token user.
ZAMMAD_ALLOW_TOKEN_USER=false
# Default group for new tickets.
ZAMMAD_DEFAULT_GROUP=Users
# Upstream request timeout in milliseconds (integer, max 600000).
ZAMMAD_TIMEOUT_MS=30000
ZAMMAD_AUDIT_LOG=

# HTTP transport. Bind address (default 127.0.0.1) and port (default 3000).
# MCP_HTTP_HOST=127.0.0.1
# PORT=3000
# Bearer token required on /mcp (Authorization: Bearer ...). At least 32
# printable ASCII characters, e.g. `openssl rand -hex 32`. Required for any
# non-loopback bind and with MCP_ALLOW_ANY_ORIGIN=true.
MCP_HTTP_TOKEN=
# Serve a non-loopback bind without a token. Only when access is restricted
# by other means.
MCP_HTTP_ALLOW_UNAUTHENTICATED=false
# Comma-separated Origin values allowed (default: localhost origins).
MCP_ALLOWED_ORIGINS=
MCP_ALLOW_ANY_ORIGIN=false
# Comma-separated host names accepted in the Host header (default: localhost
# names on a loopback bind, no check otherwise).
MCP_ALLOWED_HOSTS=
MCP_MAX_BODY_BYTES=10485760
# Failed auth attempts per client address and window before 429; 0 disables.
MCP_AUTH_FAILURE_LIMIT=20
MCP_AUTH_FAILURE_WINDOW_MS=60000
